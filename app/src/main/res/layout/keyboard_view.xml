<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1a1a1a"
    android:padding="4dp">

    <!-- Row 0: Numbers + @ — 11 keys full width -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">
        <TextView android:id="@+id/key1" style="@style/NumberKeyStyle" android:text="1"/>
        <TextView android:id="@+id/key2" style="@style/NumberKeyStyle" android:text="2"/>
        <TextView android:id="@+id/key3" style="@style/NumberKeyStyle" android:text="3"/>
        <TextView android:id="@+id/key4" style="@style/NumberKeyStyle" android:text="4"/>
        <TextView android:id="@+id/key5" style="@style/NumberKeyStyle" android:text="5"/>
        <TextView android:id="@+id/key6" style="@style/NumberKeyStyle" android:text="6"/>
        <TextView android:id="@+id/key7" style="@style/NumberKeyStyle" android:text="7"/>
        <TextView android:id="@+id/key8" style="@style/NumberKeyStyle" android:text="8"/>
        <TextView android:id="@+id/key9" style="@style/NumberKeyStyle" android:text="9"/>
        <TextView android:id="@+id/key0" style="@style/NumberKeyStyle" android:text="0"/>
        <TextView android:id="@+id/keyAt" style="@style/NumberKeyStyle" android:text="@"/>
    </LinearLayout>

    <!-- Row 1: Q-P — 10 keys full width, decides letter key size -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">
        <TextView android:id="@+id/keyQ" style="@style/KeyStyle" android:text="q"/>
        <TextView android:id="@+id/keyW" style="@style/KeyStyle" android:text="w"/>
        <TextView android:id="@+id/keyE" style="@style/KeyStyle" android:text="e"/>
        <TextView android:id="@+id/keyR" style="@style/KeyStyle" android:text="r"/>
        <TextView android:id="@+id/keyT" style="@style/KeyStyle" android:text="t"/>
        <TextView android:id="@+id/keyY" style="@style/KeyStyle" android:text="y"/>
        <TextView android:id="@+id/keyU" style="@style/KeyStyle" android:text="u"/>
        <TextView android:id="@+id/keyI" style="@style/KeyStyle" android:text="i"/>
        <TextView android:id="@+id/keyO" style="@style/KeyStyle" android:text="o"/>
        <TextView android:id="@+id/keyP" style="@style/KeyStyle" android:text="p"/>
    </LinearLayout>

    <!-- Row 2: A-L — 9 keys centered with spacers on sides -->
    <!-- spacers use 0dp height — actual height controlled by Kotlin dynamically -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">
        <View
            android:layout_width="0dp"
            android:layout_weight="0.5"
            android:layout_height="0dp"/>
        <TextView android:id="@+id/keyA" style="@style/KeyStyle" android:text="a"/>
        <TextView android:id="@+id/keyS" style="@style/KeyStyle" android:text="s"/>
        <TextView android:id="@+id/keyD" style="@style/KeyStyle" android:text="d"/>
        <TextView android:id="@+id/keyF" style="@style/KeyStyle" android:text="f"/>
        <TextView android:id="@+id/keyG" style="@style/KeyStyle" android:text="g"/>
        <TextView android:id="@+id/keyH" style="@style/KeyStyle" android:text="h"/>
        <TextView android:id="@+id/keyJ" style="@style/KeyStyle" android:text="j"/>
        <TextView android:id="@+id/keyK" style="@style/KeyStyle" android:text="k"/>
        <TextView android:id="@+id/keyL" style="@style/KeyStyle" android:text="l"/>
        <View
            android:layout_width="0dp"
            android:layout_weight="0.5"
            android:layout_height="0dp"/>
    </LinearLayout>

    <!-- Row 3: SHF + Z-M + DEL -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">
        <TextView android:id="@+id/keyShift"
            style="@style/ActionKeyStyle"
            android:text="SHF"/>
        <TextView android:id="@+id/keyZ" style="@style/KeyStyle" android:text="z"/>
        <TextView android:id="@+id/keyX" style="@style/KeyStyle" android:text="x"/>
        <TextView android:id="@+id/keyC" style="@style/KeyStyle" android:text="c"/>
        <TextView android:id="@+id/keyV" style="@style/KeyStyle" android:text="v"/>
        <TextView android:id="@+id/keyB" style="@style/KeyStyle" android:text="b"/>
        <TextView android:id="@+id/keyN" style="@style/KeyStyle" android:text="n"/>
        <TextView android:id="@+id/keyM" style="@style/KeyStyle" android:text="m"/>
        <TextView android:id="@+id/keyDel"
            style="@style/ActionKeyStyle"
            android:text="DEL"/>
    </LinearLayout>

    <!-- Row 4: SYM , . SPACE ENT -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView android:id="@+id/keySym"
            style="@style/ActionKeyStyle"
            android:text="SYM"/>
        <TextView android:id="@+id/keyComma"
            style="@style/KeyStyle"
            android:layout_weight="1"
            android:text=","/>
        <TextView android:id="@+id/keyPeriod"
            style="@style/KeyStyle"
            android:layout_weight="1"
            android:text="."/>
        <TextView android:id="@+id/keySpace"
            style="@style/ActionKeyStyle"
            android:layout_weight="3.5"
            android:text="SPACE"/>
        <TextView android:id="@+id/keyEnter"
            style="@style/ActionKeyStyle"
            android:text="ENT"/>
    </LinearLayout>

</LinearLayout>